# ==========================================
# UpFlex - Email Notification Configuration
# ==========================================

# 1. Obtain a free API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# 2. Sender Address:
# For development/testing: use "onboarding@resend.dev"
# For production (once you verify your domain upflexsolutions.org on Resend): use e.g. "UpFlex <notifications@upflexsolutions.org>"
RESEND_FROM_EMAIL=UpFlex Applications <onboarding@resend.dev>

# 3. Notification Recipient Emails (comma-separated):
# By default, notifications are sent to the Lead & Co-Lead:
CONTACT_NOTIFICATION_EMAIL=aizazahmed44@gmail.com,osamakhan.professional@gmail.com
